[Unit]
Description=SWA Logical Engine REST (Uvicorn)
After=network.target

[Service]
Type=simple
User=alifer.ramos
WorkingDirectory=/mnt/PROJECTS/model-with-adpter-logic-semantic
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/mnt/PROJECTS/model-with-adpter-logic-semantic/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/mnt/PROJECTS/model-with-adpter-logic-semantic/venv/bin/python -m uvicorn swa.rest_server:app --host 0.0.0.0 --port 20000
Restart=on-failure
RestartSec=5s
StandardOutput=append:/mnt/PROJECTS/model-with-adpter-logic-semantic/server.log
StandardError=append:/mnt/PROJECTS/model-with-adpter-logic-semantic/server.log

[Install]
WantedBy=multi-user.target
